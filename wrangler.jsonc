{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parade-state",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Run the Worker near the database (Supabase, Singapore) rather than near the visitor:
  // every request makes several database round trips and only one round trip to the visitor.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Set to "true" only on a demo or staging deployment. Enables the demo clock,
    // simulated offline controls and one-tap demo sign-in. The real-roll deployment keeps
    // this "false" and is never seeded: the roll is built by S1 and the commanders.
    "DEMO_CONTROLS": "false"
  },
  // Secrets (set with `wrangler secret put` or in the Cloudflare dashboard):
  //   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
  //   SUPABASE_DB_URL (transaction-mode pooler, port 6543),
  //   SUPABASE_JWT_SECRET (only for legacy projects using a shared HS256 secret),
  //   BOOTSTRAP_ADMIN_PASSWORD (one-time, creates the first S1 admin)
  //
  // Hyperdrive pools connections to Supabase's transaction-mode pooler near the database.
  // The Worker falls back to SUPABASE_DB_URL when the binding is absent (local dev, tests).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "c7714a60c3f840f2be3ee0b7e2f0aaf2" }],
  "triggers": {
    // 10:05 and 14:05 Singapore time: mark unsubmitted units Late and keep Supabase awake.
    "crons": ["5 2 * * *", "5 6 * * *"]
  },
  "observability": { "enabled": true }
}
