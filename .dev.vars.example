# Copy to .dev.vars for local development (never commit .dev.vars).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Transaction-mode pooler (port 6543) for the Worker at runtime.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Session-mode pooler (port 5432) for migrations and the seed script.
SUPABASE_DB_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Only for legacy projects that still sign JWTs with a shared secret.
# SUPABASE_JWT_SECRET=
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
DEMO_CONTROLS=true
